# ── Database (Postgres — Neon free tier works great with Vercel) ──────────
# Example: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=""

# ── Stripe ─────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys. Use sk_test_... while testing.
STRIPE_SECRET_KEY=""
# Dashboard → Developers → Webhooks → your endpoint → Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=""

# ── Site ───────────────────────────────────────────────────────────────────
# Used for Stripe success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Production: NEXT_PUBLIC_SITE_URL="https://store.moonsmp.org"

# ── Admin panel ────────────────────────────────────────────────────────────
# Password you type at /admin/login
ADMIN_PASSWORD=""
# Any long random string — signs the admin session cookie.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# ── Paper plugin delivery API ──────────────────────────────────────────────
# Shared secret between this site and the MoonDeliveries Paper plugin.
# Must match api-key in the plugin's config.yml. Generate like above.
PLUGIN_API_KEY=""

# ── Floodgate ──────────────────────────────────────────────────────────────
# Bedrock username prefix — must match username-prefix in floodgate/config.yml
FLOODGATE_PREFIX="."

# ── Discord sign-in (buyer identity) ────────────────────────────────────────
# Reuse the SAME values already configured for support.moonsmp.org's Vercel
# project — it's the same Discord application and the same Turso database.
# You only need to register ONE new redirect URI on that Discord app:
#   https://store.moonsmp.org/api/auth/callback
# Leaving DISCORD_CLIENT_ID unset is the kill switch: the site falls back to
# the old manual-username gate if this section is blank.
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
# Same guild ID as support.moonsmp.org — stamped onto issued link codes.
DISCORD_GUILD_ID=""
# Fresh random string, do NOT reuse support's SESSION_SECRET.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# ── Turso (Moon Handler's shared Discord↔Minecraft link table) ─────────────
# Same values as support.moonsmp.org — read+write access to links/link_codes.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Shown in the "join the server" linking instructions.
NEXT_PUBLIC_MC_HOST="MoonSMP.org"
